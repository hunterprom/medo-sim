<mujoco model="medo_placeholder">
  <!-- Placeholder quadruped sized like a hobby robot dog (~2.8 kg, 12x serial-bus
       servos ~4.5 Nm). Swap for the real Medo export via tools/convert_model.py. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-20" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="dark" rgba="0.2 0.2 0.22 1"/>
    <material name="accent" rgba="0.9 0.5 0.1 1"/>
  </asset>

  <default>
    <default class="medo">
      <joint damping="0.12" armature="0.015" frictionloss="0.08"/>
      <geom material="dark" friction="1.0 0.005 0.0001"/>
      <position kp="25" kv="0.6" inheritrange="1" forcerange="-4.5 4.5"/>
      <default class="abd">
        <joint axis="1 0 0" range="-0.7 0.7"/>
      </default>
      <default class="hip">
        <joint axis="0 1 0" range="-1.6 1.6"/>
      </default>
      <default class="knee">
        <joint axis="0 1 0" range="-2.4 -0.35"/>
      </default>
      <default class="foot">
        <geom type="sphere" size="0.018" material="accent" friction="1.0 0.005 0.0001"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" friction="1.0 0.005 0.0001"/>

    <body name="torso" pos="0 0 0.195" childclass="medo">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.12 0.06 0.03" mass="1.4"/>
      <geom name="head_geom" type="box" size="0.02 0.03 0.02" pos="0.13 0 0.02" mass="0.05" material="accent"/>
      <site name="imu" pos="0 0 0" size="0.01"/>

      <body name="FR_hip" pos="0.09 -0.06 0">
        <joint name="FR_abd" class="abd"/>
        <geom name="FR_hip_geom" type="capsule" size="0.02" fromto="0 0 0 0 -0.035 0" mass="0.15"/>
        <body name="FR_thigh" pos="0 -0.045 0">
          <joint name="FR_hip" class="hip"/>
          <geom name="FR_thigh_geom" type="capsule" size="0.015" fromto="0 0 0 0 0 -0.11" mass="0.16"/>
          <body name="FR_shank" pos="0 0 -0.11">
            <joint name="FR_knee" class="knee"/>
            <geom name="FR_shank_geom" type="capsule" size="0.012" fromto="0 0 0 0 0 -0.13" mass="0.09"/>
            <geom name="FR_foot" class="foot" pos="0 0 -0.13" mass="0.02"/>
          </body>
        </body>
      </body>

      <body name="FL_hip" pos="0.09 0.06 0">
        <joint name="FL_abd" class="abd"/>
        <geom name="FL_hip_geom" type="capsule" size="0.02" fromto="0 0 0 0 0.035 0" mass="0.15"/>
        <body name="FL_thigh" pos="0 0.045 0">
          <joint name="FL_hip" class="hip"/>
          <geom name="FL_thigh_geom" type="capsule" size="0.015" fromto="0 0 0 0 0 -0.11" mass="0.16"/>
          <body name="FL_shank" pos="0 0 -0.11">
            <joint name="FL_knee" class="knee"/>
            <geom name="FL_shank_geom" type="capsule" size="0.012" fromto="0 0 0 0 0 -0.13" mass="0.09"/>
            <geom name="FL_foot" class="foot" pos="0 0 -0.13" mass="0.02"/>
          </body>
        </body>
      </body>

      <body name="RR_hip" pos="-0.09 -0.06 0">
        <joint name="RR_abd" class="abd"/>
        <geom name="RR_hip_geom" type="capsule" size="0.02" fromto="0 0 0 0 -0.035 0" mass="0.15"/>
        <body name="RR_thigh" pos="0 -0.045 0">
          <joint name="RR_hip" class="hip"/>
          <geom name="RR_thigh_geom" type="capsule" size="0.015" fromto="0 0 0 0 0 -0.11" mass="0.16"/>
          <body name="RR_shank" pos="0 0 -0.11">
            <joint name="RR_knee" class="knee"/>
            <geom name="RR_shank_geom" type="capsule" size="0.012" fromto="0 0 0 0 0 -0.13" mass="0.09"/>
            <geom name="RR_foot" class="foot" pos="0 0 -0.13" mass="0.02"/>
          </body>
        </body>
      </body>

      <body name="RL_hip" pos="-0.09 0.06 0">
        <joint name="RL_abd" class="abd"/>
        <geom name="RL_hip_geom" type="capsule" size="0.02" fromto="0 0 0 0 0.035 0" mass="0.15"/>
        <body name="RL_thigh" pos="0 0.045 0">
          <joint name="RL_hip" class="hip"/>
          <geom name="RL_thigh_geom" type="capsule" size="0.015" fromto="0 0 0 0 0 -0.11" mass="0.16"/>
          <body name="RL_shank" pos="0 0 -0.11">
            <joint name="RL_knee" class="knee"/>
            <geom name="RL_shank_geom" type="capsule" size="0.012" fromto="0 0 0 0 0 -0.13" mass="0.09"/>
            <geom name="RL_foot" class="foot" pos="0 0 -0.13" mass="0.02"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="FR_abd" joint="FR_abd" class="medo"/>
    <position name="FR_hip" joint="FR_hip" class="medo"/>
    <position name="FR_knee" joint="FR_knee" class="medo"/>
    <position name="FL_abd" joint="FL_abd" class="medo"/>
    <position name="FL_hip" joint="FL_hip" class="medo"/>
    <position name="FL_knee" joint="FL_knee" class="medo"/>
    <position name="RR_abd" joint="RR_abd" class="medo"/>
    <position name="RR_hip" joint="RR_hip" class="medo"/>
    <position name="RR_knee" joint="RR_knee" class="medo"/>
    <position name="RL_abd" joint="RL_abd" class="medo"/>
    <position name="RL_hip" joint="RL_hip" class="medo"/>
    <position name="RL_knee" joint="RL_knee" class="medo"/>
  </actuator>

  <sensor>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
  </sensor>

  <keyframe>
    <key name="home"
         qpos="0 0 0.195 1 0 0 0  0 0.75 -1.5  0 0.75 -1.5  0 0.75 -1.5  0 0.75 -1.5"
         ctrl="0 0.75 -1.5  0 0.75 -1.5  0 0.75 -1.5  0 0.75 -1.5"/>
  </keyframe>
</mujoco>
